# general
SHOW_CHANGED_FILES=true
SHOW_RAW_COMMITS=true
MAX_FILES=10        # truncate changed files list after N entries
MAX_COMMITS=10      # truncate commit list after N entries
NOTIFY_ON_NO_CHANGES=true   # post a "no changes" Slack message on no-op deploys

# gitlab
# Automatically injected by GitLab CI — only needed for local development
# CI_API_V4_URL=https://gitlab.com/api/v4
GITLAB_TOKEN=
GITLAB_PROJECT_ID=
GITLAB_PROJECT_NAME=
CI_COMMIT_SHA=
CI_COMMIT_BRANCH=

# LLM provider — "openai" (default) or "claude"
# Only the API key matching your chosen provider is required.
LLM_PROVIDER=openai

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Anthropic (used when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C0XXXXXXXXX
